# ---- Chiral Network — repository ignores ---------------------------------

# Node / Electron build artifacts
node_modules/
dist/
out/
build/
*.tsbuildinfo

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/

# Logs / temp / crash dumps
*.log
*.tmp
*.pid
*.bak

# Resolve script runtime fixtures (written by the live scripts)
scripts/resolve/last_dialog.txt
scripts/resolve/resolve_python_test.txt

# Per-developer state — paths and config we never want in the repo
app/settings.json
app/config.local.json

# Python interpreter chaff (in case anyone runs the resolve scripts directly)
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
.python-version

# ---- Media: never commit shot footage, renders, or previews --------------
# These live under projects/ at runtime; the structure is generated, not
# tracked. Extensions are listed individually rather than via projects/**
# so a contributor who symlinks a sample shot into a docs/ subtree still
# gets the right behavior.
*.mp4
*.mov
*.webm
*.mkv
*.avi
*.exr
*.dpx
*.tif
*.tiff
*.png
*.jpg
*.jpeg
*.psd
*.aep
*.prproj

# ---- Bridge round-trip artifacts (never commit) --------------------------
# These files are generated by the live AE↔Resolve loop and rotate every run.
.render-progress.json
.relink.json
.tmp_*
*_tmp/
projects/
roundtrip_*.txt
roundtrip_*.json
roundtrip_*.log

# ---- Python interpreter / ffmpeg vendored binaries -----------------------
# vendor/ is populated by the Setup Wizard at install time, not from git.
# Removing this line will accidentally bloat the repo by hundreds of MB.
vendor/

# ---- Distribution outputs ------------------------------------------------
*.exe
*.msi
*.zip
*.7z
*.tar.gz
Roundtrip-*/
ChiralNetwork-*/
Chiral-Network-*/
